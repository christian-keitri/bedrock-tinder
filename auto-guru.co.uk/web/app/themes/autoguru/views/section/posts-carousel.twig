<div class="w-full h-100 bg-secondary flex justify-center items-center">
  {% for post in posts %}
    <div class="w-1/3 p-4">
      <div class="bg-white rounded-lg shadow-lg p-6">
        <h2 class="text-xl font-bold mb-2">{{ post.title }}</h2>
        <p class="text-gray-700 mb-4">{{ post.excerpt }}</p>
      </div>
    </div>
  {% endfor %}
</div>


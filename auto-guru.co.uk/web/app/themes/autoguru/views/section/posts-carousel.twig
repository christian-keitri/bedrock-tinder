{# <div class="w-full h-200 bg-secondary flex justify-center items-center px-40"> #}

<div class="w-full h-200 bg-secondary flex justify-center items-center px-40">
  {% for post in posts %}
    <div class="p-4 w-1/3">
      <div class="bg-black bg-cover bg-center bg-no-repeat h-150 w-full rounded-lg shadow-lg p-6 flex flex-col justify-end group transition-all duration-300 hover:shadow-xl relative overflow-hidden"  style="background-image: url('{{ post.image }}');">
        <div class="absolute inset-0 bg-black/90 group-hover:bg-black/40 transition-colors duration-300"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 -translate-x-full translate-y-full group-hover:translate-x-0 group-hover:translate-y-0 transition-transform rounded-[100%] scale-150"></div>
        <h2 class="text-4xl font-medium mb-2 text-textColor relative z-10">{{ post.title }}</h2>
        <p class="text-textColor my-4 font-normal text-base relative z-10">{{ post.excerpt }}</p>
        <a href="{{ post.url }}" class="text-primary font-normal text-base mt-4 flex items-center relative z-10 group-hover:text-textColor">
          {{ post.more }} <i class="fas fa-arrow-right ml-2 transition-transform duration-300 group-hover:translate-x-2"></i>
        </a>
      </div>
    </div>
  {% endfor %}
</div>
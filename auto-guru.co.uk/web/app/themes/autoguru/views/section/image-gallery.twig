<div class="w-full bg-secondary">
    {# Top grey divider #}
    <div class="w-full h-px bg-gray-200"></div>

    {# Gallery container #}
    <div class="relative w-full py-12 overflow-hidden">
        <div class="animate-scroll flex gap-6">
            {% for i in 1..99 %}
                {% for image in images %}
                    <div class="flex-none logo-wrapper">
                        <img 
                            src="{{ image.url ?? image }}"
                            class="w-full h-full object-contain"
                            alt="Gallery Logo"
                        >
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    </div>

    {# Bottom grey divider #}
    <div class="w-full h-px bg-gray-200"></div>
</div>

<style>
    @keyframes scroll {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(calc(-88.88% - 2rem));
        }
    }

    .animate-scroll {
        animation: scroll 30s linear infinite;
        width: calc(300% + 6rem);
        display: flex;
        gap: 1.5rem;
    }

    .animate-scroll:hover {
        animation-play-state: paused;
    }

    .logo-wrapper {
        flex: 0 0 10%; /* Base percentage size */
        aspect-ratio: 1 / 1;
        position: relative;
    }

    .logo-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        max-width: 100%;
        max-height: 100%;
    }

    /* Responsive logo sizing using percentages */
    @media screen and (max-width: 1024px) {
        .logo-wrapper {
            flex: 0 0 12%;
        }
    }

    @media screen and (max-width: 768px) {
        .logo-wrapper {
            flex: 0 0 14%;
        }
    }

    @media screen and (max-width: 480px) {
        .logo-wrapper {
            flex: 0 0 18%;
        }

        .animate-scroll {
            gap: 1rem;
        }

        .relative.w-full.py-12 {
            padding-top: 2rem;
            padding-bottom: 2rem;
        }
    }

    /* Hide scrollbars if needed */
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }

    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

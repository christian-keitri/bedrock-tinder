<section class="bg-white py-16">
    <div class="container mx-auto px-20"> {# <div class="container mx-auto px-70"> #} {#original #}
        <div class="flex flex-col w-full max-w-[648px] mx-auto gap-4 sm:flex-row sm:justify-center sm:items-center"> {##}
            {% for member in members %}
                <div class="text-center">
                    <div class="relative mb-4"> {#<div class="relative aspect-square mb-4">#}
                        <img 
                            src="{{ member.image }}" 
                            alt="{{ member.name }}"
                            <img 
                              src="{{ member.image }}" 
                              alt="{{ member.name }}"
                              class="w-[220px] h-auto sm:w-[320px] sm:h-auto md:w-[220px] md:h-[220px] object-cover grayscale mx-auto" {##}

                        >
                    </div>
                    <h3 class="text-xl font-medium mb-1">{{ member.name }}</h3>
                    <p class="text-gray-600 text-sm">{{ member.role }}</p>
                    <div class="flex justify-center gap-4 mt-3">
                        <a href="{{ member.linkedin|default('#') }}" class="text-gray-600 hover:text-black">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                            </svg>
                        </a>
                        <a href="{{ member.email|default('#') }}" class="text-gray-600 hover:text-black">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>